{
  "uid": "infra-monitor",
  "title": "Infrastructure Monitor",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "infra"
  ],
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage %",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT collected_at AS time, host AS metric, cpu_percent AS value FROM metrics WHERE $__timeFilter(collected_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory usage %",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT collected_at AS time, host AS metric, memory_percent AS value FROM metrics WHERE $__timeFilter(collected_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk usage %",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "percent",
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT collected_at AS time, host AS metric, disk_percent AS value FROM metrics WHERE $__timeFilter(collected_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Check response time (ms)",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT checked_at AS time, name AS metric, response_ms AS value FROM check_results WHERE $__timeFilter(checked_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Open alerts",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at AS \"Opened\", severity AS \"Severity\", source AS \"Source\", message AS \"Message\", remediation_note AS \"Auto-remediation\" FROM alerts WHERE status = 'OPEN' ORDER BY created_at DESC"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Service checks (latest)",
      "datasource": {
        "type": "postgres",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "monitor-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (name) name AS \"Check\", check_type AS \"Type\", target AS \"Target\", is_up AS \"Up\", response_ms AS \"ms\", message AS \"Message\", checked_at AS \"Checked\" FROM check_results ORDER BY name, checked_at DESC"
        }
      ]
    }
  ]
}